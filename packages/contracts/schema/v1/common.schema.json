{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.environment-REDACTED.dev/v1/common.schema.json",
  "title": "Environment Reconciler Common Contract Types v1",
  "description": "Primitive and shared structures used by every v1 wire contract.",
  "$defs": {
    "SchemaVersion": {
      "type": "integer",
      "const": 1
    },
    "EntityId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "OpaqueTokenId": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "GitObjectId": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "Rfc3339Timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "DecimalCounter": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)$",
      "maxLength": 32
    },
    "DurationMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ByteCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "Confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "NonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "ShortString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "BoundedString": {
      "type": "string",
      "maxLength": 16384
    },
    "RelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?:[^./\\\\:\\u0000][^/\\\\:\\u0000]*|\\.[^./\\\\:\\u0000][^/\\\\:\\u0000]*|\\.\\.[^/\\\\:\\u0000]+)(?:/(?:[^./\\\\:\\u0000][^/\\\\:\\u0000]*|\\.[^./\\\\:\\u0000][^/\\\\:\\u0000]*|\\.\\.[^/\\\\:\\u0000]+))*$"
    },
    "HttpUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "maxLength": 4096
    },
    "Base64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 16384,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "Base64Url": {
      "type": "string",
      "minLength": 4,
      "maxLength": 16384,
      "pattern": "^[A-Za-z0-9_-]+={0,2}$"
    },
    "StringMap": {
      "type": "object",
      "maxProperties": 256,
      "additionalProperties": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "VersionMap": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 256
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "AssessmentState": {
      "type": "string",
      "enum": ["known", "unknown", "partial", "not_applicable", "unsupported", "inconclusive"]
    },
    "Assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reasonCodes", "evidenceReferenceIds"],
      "properties": {
        "state": {
          "$ref": "#/$defs/AssessmentState"
        },
        "reasonCodes": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/ShortString"
          }
        },
        "evidenceReferenceIds": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/EntityId"
          }
        }
      }
    },
    "CapabilityState": {
      "type": "string",
      "enum": ["supported", "partial", "unavailable", "unknown", "not_applicable", "unsupported"]
    },
    "SupportLevel": {
      "type": "string",
      "enum": ["full_native", "native_validation", "observed_only", "unsupported", "unknown"]
    },
    "HealthState": {
      "type": "string",
      "enum": ["healthy", "degraded", "unavailable", "unknown"]
    },
    "VersionedReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "$ref": "#/$defs/EntityId"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "DigestReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": {
          "$ref": "#/$defs/EntityId"
        },
        "digest": {
          "$ref": "#/$defs/Sha256Digest"
        }
      }
    },
    "FieldIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "keyword", "code"],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 2048
        },
        "keyword": {
          "$ref": "#/$defs/ShortString"
        },
        "code": {
          "$ref": "#/$defs/ShortString"
        }
      }
    },
    "ProtocolError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "issues"],
      "properties": {
        "code": {
          "$ref": "#/$defs/ShortString"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "retryable": {
          "type": "boolean"
        },
        "issues": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/FieldIssue"
          }
        }
      }
    }
  }
}
