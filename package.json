{
  "name": "environment-REDACTED",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "check": "pnpm run format:check && pnpm run contracts:check && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run contracts:smoke && pnpm run test && pnpm run rust:check && pnpm run extension:package && pnpm run deploy:dry",
    "clean": "pnpm -r --if-present run clean",
    "contracts:check": "node --import tsx scripts/generate-contracts.ts --check",
    "contracts:generate": "node --import tsx scripts/generate-contracts.ts",
    "contracts:smoke": "node scripts/smoke-contracts-dist.mjs",
    "db:migrate": "pnpm --filter @environment-REDACTED/worker run db:migrate",
    "deploy": "pnpm run web:build && wrangler deploy --env-file .env",
    "deploy:dry": "pnpm run web:build && wrangler deploy --dry-run --env-file .dev.vars.example",
    "demo:sponsors": "node --env-file=.env --import tsx scripts/demo-sponsor-server.ts",
    "dev": "pnpm run web:build && wrangler dev --env-file .env",
    "env:check": "node --env-file=.env --import tsx scripts/validate-env.ts",
    "extension:package": "pnpm --dir apps/extension run package",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache .",
    "lint": "pnpm run types && eslint . --max-warnings 0",
    "playwright": "playwright test",
    "rust:check": "cargo fmt --all --check && cargo clippy --workspace --all-targets --all-features -- -D warnings && cargo test --workspace --all-features",
    "test:github-app": "node --env-file=.env scripts/test-github-app.mjs",
    "test:braintrust": "node --env-file=.env scripts/test-braintrust.mjs",
    "test:daytona": "node --env-file=.env --import tsx scripts/test-daytona.ts",
    "test:fireworks": "node --env-file=.env scripts/test-fireworks.mjs",
    "test:r2": "node --env-file=.env scripts/test-r2.mjs",
    "test:r2:sdk": "node --env-file=.env --import tsx packages/integrations/src/smoke/r2.ts",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "pnpm run types && pnpm run typecheck:root && pnpm -r --if-present run typecheck",
    "typecheck:root": "tsc --noEmit -p tsconfig.json",
    "types": "wrangler types worker-configuration.d.ts --env-file .dev.vars.example",
    "types:check": "wrangler types worker-configuration.d.ts --env-file .dev.vars.example --check",
    "web:build": "pnpm --filter @environment-REDACTED/web run build"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@cloudflare/workers-types": "^5.20260724.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "3.0.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "4.9.0",
    "globals": "^16.4.0",
    "json-schema-to-typescript": "15.0.4",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.114.0"
  }
}
