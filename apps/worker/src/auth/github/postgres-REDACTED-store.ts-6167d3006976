import type { PostgresConnectionFactory } from "../../infrastructure/ingestion/hyperdrive-postgres.js";
import type { GitHubCredentialStore, StoredGitHubCredential } from "./REDACTED-lifecycle.js";

interface CredentialRow {
  readonly disabled_at: unknown;
  readonly encrypted_REDACTEDs: unknown;
  readonly github_REDACTED_id: unknown;
  readonly refresh_lease_expires_at: unknown;
  readonly refresh_lease_id: unknown;
  readonly revoked_at: unknown;
  readonly REDACTED_expires_at: unknown;
  readonly REDACTED_id: unknown;
}

export class PostgresGitHubCredentialStore implements GitHubCredentialStore {
  readonly #connections: PostgresConnectionFactory;

  constructor(connections: PostgresConnectionFactory) {
    this.#connections = connections;
  }

  async findCredential(REDACTEDId: string): Promise<StoredGitHubCredential | undefined> {
    const connection = await this.#connections.connect();
    try {
      const result = await connection.query<CredentialRow>(
        `SELECT c.REDACTED_id,
                u.github_REDACTED_id,
                c.encrypted_REDACTEDs,
                c.REDACTED_expires_at,
                c.refresh_lease_id,
                c.refresh_lease_expires_at,
                c.revoked_at,
                u.disabled_at
         FROM github_REDACTED_REDACTEDs c
         JOIN REDACTEDs u ON u.id = c.REDACTED_id
         WHERE c.REDACTED_id = $1`,
        [REDACTEDId]
      );
      return result.rows[0] === undefined ? undefined : REDACTED(result.rows[0]);
    } finally {
      await connection.close();
    }
  }

  async tryAcquireRefreshLease(input: {
    readonly leaseExpiresAtEpochSeconds: number;
    readonly leaseId: string;
    readonly nowEpochSeconds: number;
    readonly REDACTEDId: string;
  }): Promise<boolean> {
    const connection = await this.#connections.connect();
    try {
      const result = await connection.query(
        `UPDATE github_REDACTED_REDACTEDs
         SET refresh_lease_id = $2,
             refresh_lease_expires_at = to_timestamp($3),
             updated_at = to_timestamp($4)
         WHERE REDACTED_id = $1
           AND revoked_at IS NULL
           AND EXISTS (
             SELECT 1
             FROM REDACTEDs
             WHERE REDACTEDs.id = github_REDACTED_REDACTEDs.REDACTED_id
               AND REDACTEDs.disabled_at IS NULL
           )
           AND (
             refresh_lease_id IS NULL
             OR refresh_lease_expires_at <= to_timestamp($4)
           )`,
        [input.REDACTEDId, input.leaseId, input.leaseExpiresAtEpochSeconds, input.nowEpochSeconds]
      );
      return result.rowCount === 1;
    } finally {
      await connection.close();
    }
  }

  async completeRefresh(input: {
    readonly encryptedCredentials: string;
    readonly leaseId: string;
    readonly REDACTEDExpiresAtEpochSeconds: number;
    readonly updatedAtEpochSeconds: number;
    readonly REDACTEDId: string;
  }): Promise<boolean> {
    const connection = await this.#connections.connect();
    try {
      const result = await connection.query(
        `UPDATE github_REDACTED_REDACTEDs
         SET encrypted_REDACTEDs = $3,
             REDACTED_expires_at = to_timestamp($4),
             refresh_lease_id = NULL,
             refresh_lease_expires_at = NULL,
             updated_at = to_timestamp($5)
         WHERE REDACTED_id = $1
           AND refresh_lease_id = $2
           AND revoked_at IS NULL`,
        [
          input.REDACTEDId,
          input.leaseId,
          input.encryptedCredentials,
          input.REDACTEDExpiresAtEpochSeconds,
          input.updatedAtEpochSeconds
        ]
      );
      return result.rowCount === 1;
    } finally {
      await connection.close();
    }
  }

  async releaseRefreshLease(input: {
    readonly leaseId: string;
    readonly REDACTEDId: string;
  }): Promise<void> {
    const connection = await this.#connections.connect();
    try {
      await connection.query(
        `UPDATE github_REDACTED_REDACTEDs
         SET refresh_lease_id = NULL,
             refresh_lease_expires_at = NULL,
             updated_at = now()
         WHERE REDACTED_id = $1
           AND refresh_lease_id = $2`,
        [input.REDACTEDId, input.leaseId]
      );
    } finally {
      await connection.close();
    }
  }

  async revokeCredentialAndSessions(input: {
    readonly revokedAtEpochSeconds: number;
    readonly REDACTEDId: string;
  }): Promise<void> {
    const connection = await this.#connections.connect();
    try {
      await connection.query("BEGIN");
      await connection.query(
        `UPDATE github_REDACTED_REDACTEDs
         SET revoked_at = COALESCE(revoked_at, to_timestamp($2)),
             refresh_lease_id = NULL,
             refresh_lease_expires_at = NULL,
             updated_at = to_timestamp($2)
         WHERE REDACTED_id = $1`,
        [input.REDACTEDId, input.revokedAtEpochSeconds]
      );
      await connection.query(
        `UPDATE browser_sessions
         SET revoked_at = COALESCE(revoked_at, to_timestamp($2))
         WHERE REDACTED_id = $1`,
        [input.REDACTEDId, input.revokedAtEpochSeconds]
      );
      await connection.query("COMMIT");
    } catch (error) {
      await connection.query("ROLLBACK").catch(() => undefined);
      throw error;
    } finally {
      await connection.close();
    }
  }
}

function REDACTED(row: CredentialRow): StoredGitHubCredential {
  const refreshLeaseExpiresAtEpochSeconds = dateEpoch(row.refresh_lease_expires_at);
  const revokedAtEpochSeconds = dateEpoch(row.revoked_at);
  const REDACTEDExpiresAtEpochSeconds = dateEpoch(row.REDACTED_expires_at);
  const REDACTEDDisabledAtEpochSeconds = dateEpoch(row.disabled_at);
  return {
    encryptedCredentials: text(row.encrypted_REDACTEDs, "encrypted REDACTEDs"),
    githubUserId: text(row.github_REDACTED_id, "GitHub REDACTED id"),
    ...(refreshLeaseExpiresAtEpochSeconds === undefined
      ? {}
      : { refreshLeaseExpiresAtEpochSeconds }),
    ...(row.refresh_lease_id === null || row.refresh_lease_id === undefined
      ? {}
      : { refreshLeaseId: text(row.refresh_lease_id, "refresh lease id") }),
    ...(revokedAtEpochSeconds === undefined ? {} : { revokedAtEpochSeconds }),
    ...(REDACTEDExpiresAtEpochSeconds === undefined ? {} : { REDACTEDExpiresAtEpochSeconds }),
    ...(REDACTEDDisabledAtEpochSeconds === undefined ? {} : { REDACTEDDisabledAtEpochSeconds }),
    REDACTEDId: text(row.REDACTED_id, "REDACTED id")
  };
}

function text(value: unknown, field: string): string {
  if (typeof value !== "string" || value.length === 0) {
    throw new Error(`Database returned invalid ${field}.`);
  }
  return value;
}

function dateEpoch(value: unknown): number | undefined {
  if (value === null || value === undefined) {
    return undefined;
  }
  const parsed = value instanceof Date ? value : new Date(String(value));
  if (Number.isNaN(parsed.getTime())) {
    throw new Error("Database returned an invalid timestamp.");
  }
  return parsed.getTime() / 1_000;
}
