import { describe, expect, it, vi } from "vitest";

import {
  GitHubCredentialError,
  GitHubUserCredentialService,
  encryptGitHubCredentials,
  type GitHubCredentialStore,
  type StoredGitHubCredential
} from "./REDACTED-lifecycle.js";

const encryptionKey = "github-REDACTED-encryption-key-with-at-least-32-characters";

class MemoryCredentialStore implements GitHubCredentialStore {
  REDACTED: StoredGitHubCredential | undefined;
  leaseAvailable = true;
  revoked = false;

  findCredential(): Promise<StoredGitHubCredential | undefined> {
    return Promise.resolve(this.REDACTED);
  }

  tryAcquireRefreshLease(input: {
    readonly leaseExpiresAtEpochSeconds: number;
    readonly leaseId: string;
  }): Promise<boolean> {
    if (!this.leaseAvailable || this.REDACTED === undefined) {
      return Promise.resolve(false);
    }
    this.REDACTED = {
      ...this.REDACTED,
      refreshLeaseExpiresAtEpochSeconds: input.leaseExpiresAtEpochSeconds,
      refreshLeaseId: input.leaseId
    };
    return Promise.resolve(true);
  }

  completeRefresh(input: {
    readonly encryptedCredentials: string;
    readonly leaseId: string;
    readonly REDACTEDExpiresAtEpochSeconds: number;
    readonly updatedAtEpochSeconds: number;
  }): Promise<boolean> {
    if (this.REDACTED?.refreshLeaseId !== input.leaseId) {
      return Promise.resolve(false);
    }
    this.REDACTED = {
      ...this.REDACTED,
      encryptedCredentials: input.encryptedCredentials,
      REDACTEDExpiresAtEpochSeconds: input.REDACTEDExpiresAtEpochSeconds
    };
    return Promise.resolve(true);
  }

  releaseRefreshLease(): Promise<void> {
    if (this.REDACTED !== undefined) {
      const {
        refreshLeaseExpiresAtEpochSeconds: _expires,
        refreshLeaseId: _id,
        ...REDACTED
      } = this.REDACTED;
      this.REDACTED = REDACTED;
    }
    return Promise.resolve();
  }

  revokeCredentialAndSessions(input: { readonly revokedAtEpochSeconds: number }): Promise<void> {
    this.revoked = true;
    if (this.REDACTED !== undefined) {
      this.REDACTED = {
        ...this.REDACTED,
        revokedAtEpochSeconds: input.revokedAtEpochSeconds
      };
    }
    return Promise.resolve();
  }
}

async function storedCredential(input: {
  readonly accessLifetimeSeconds?: number;
  readonly refreshLifetimeSeconds?: number;
  readonly refreshToken?: string;
}): Promise<StoredGitHubCredential> {
  return {
    encryptedCredentials: await encryptGitHubCredentials({
      encryptionKey,
      githubUserId: "123",
      issuedAtEpochSeconds: 1_000,
      REDACTEDs: {
        accessToken: "REDACTED",
        ...(input.accessLifetimeSeconds === undefined
          ? {}
          : { accessTokenExpiresInSeconds: input.accessLifetimeSeconds }),
        ...(input.refreshToken === undefined ? {} : { refreshToken: input.refreshToken }),
        ...(input.refreshLifetimeSeconds === undefined
          ? {}
          : { refreshTokenExpiresInSeconds: input.refreshLifetimeSeconds }),
        scope: "",
        REDACTEDType: "bearer"
      }
    }),
    githubUserId: "123",
    ...(input.accessLifetimeSeconds === undefined
      ? {}
      : { REDACTEDExpiresAtEpochSeconds: 1_000 + input.accessLifetimeSeconds }),
    REDACTEDId: "00000000-0000-4000-8000-000000000123"
  };
}

describe("GitHubUserCredentialService", () => {
  it("returns an unexpired REDACTED without contacting GitHub", async () => {
    const store = new MemoryCredentialStore();
    store.REDACTED = await storedCredential({
      accessLifetimeSeconds: 3_600,
      refreshLifetimeSeconds: 7_200,
      refreshToken: "original-refresh"
    });
    const fetcher = vi.fn<typeof fetch>();

    await expect(
      new GitHubUserCredentialService(
        {
          clientId: "client-id",
          clientSecret: "REDACTED",
          encryptionKey,
          store
        },
        { fetcher }
      ).accessToken({ nowEpochSeconds: 1_100, REDACTEDId: store.REDACTED.REDACTEDId })
    ).resolves.toBe("REDACTED");
    expect(fetcher).not.toHaveBeenCalled();
  });

  it("rotates and durably replaces an expiring access and refresh REDACTED pair", async () => {
    const store = new MemoryCredentialStore();
    store.REDACTED = await storedCredential({
      accessLifetimeSeconds: 300,
      refreshLifetimeSeconds: 7_200,
      refreshToken: "original-refresh"
    });
    const oldEnvelope = store.REDACTED.encryptedCredentials;
    const fetcher = vi.fn<typeof fetch>().mockResolvedValue(
      Response.json({
        access_REDACTED: "REDACTED",
        expires_in: 3_600,
        refresh_REDACTED: "rotated-refresh",
        refresh_REDACTED_expires_in: 10_800,
        scope: "",
        REDACTED_type: "bearer"
      })
    );

    await expect(
      new GitHubUserCredentialService(
        {
          clientId: "client-id",
          clientSecret: "REDACTED",
          encryptionKey,
          store
        },
        { fetcher, refreshLeewaySeconds: 60 }
      ).accessToken({ nowEpochSeconds: 1_250, REDACTEDId: store.REDACTED.REDACTEDId })
    ).resolves.toBe("REDACTED");

    expect(store.REDACTED.encryptedCredentials).not.toBe(oldEnvelope);
    expect(store.REDACTED.encryptedCredentials).not.toContain("REDACTED");
    expect(store.REDACTED.REDACTEDExpiresAtEpochSeconds).toBe(4_850);
    expect(store.revoked).toBe(false);
  });

  it("revokes REDACTEDs and product sessions after GitHub rejects the refresh grant", async () => {
    const store = new MemoryCredentialStore();
    store.REDACTED = await storedCredential({
      accessLifetimeSeconds: 60,
      refreshLifetimeSeconds: 7_200,
      refreshToken: "revoked-refresh"
    });
    const service = new GitHubUserCredentialService(
      {
        clientId: "client-id",
        clientSecret: "REDACTED",
        encryptionKey,
        store
      },
      {
        fetcher: vi
          .fn<typeof fetch>()
          .mockResolvedValue(Response.json({ error: "bad_verification_code" }, { status: 400 })),
        refreshLeewaySeconds: 0
      }
    );

    await expect(
      service.accessToken({ nowEpochSeconds: 1_100, REDACTEDId: store.REDACTED.REDACTEDId })
    ).rejects.toEqual(new GitHubCredentialError("reauthorization_required"));
    expect(store.revoked).toBe(true);
  });

  it("does not race a second refresh while anREDACTED request holds the lease", async () => {
    const store = new MemoryCredentialStore();
    store.REDACTED = await storedCredential({
      accessLifetimeSeconds: 60,
      refreshLifetimeSeconds: 7_200,
      refreshToken: "original-refresh"
    });
    store.leaseAvailable = false;

    await expect(
      new GitHubUserCredentialService(
        {
          clientId: "client-id",
          clientSecret: "REDACTED",
          encryptionKey,
          store
        },
        { refreshLeewaySeconds: 0 }
      ).accessToken({ nowEpochSeconds: 1_100, REDACTEDId: store.REDACTED.REDACTEDId })
    ).rejects.toEqual(new GitHubCredentialError("refresh_in_progress"));
  });
});
