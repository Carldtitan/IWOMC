  "fixtures": [
    {
      "fixtureId": "secret-api-key",
      "title": "Synthetic API key",
      "description": "A deliberately non-working API-key-shaped value must be detected before persistence and replaced by a typed marker.",
      "input": {
        "source": "environment",
        "fieldName": "EXAMPLE_API_KEY",
        "syntheticValue": "sk-test_FAKE_51HACKATHON_NOT_A_REAL_KEY_000000"
      },
      "expected": {
        "outcome": "redacted",
        "secretDetected": true,
        "reasonCode": "api-key",
        "redactedValue": "<redacted:api-key>",
        "plaintextPersistence": "forbidden",
        "hmacFingerprintAllowed": true
      }
    },
    {
