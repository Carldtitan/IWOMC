# Verified Environment Reconciliation
# Local development template.
#
# Copy this file to `.env`, fill in the blank values, and never commit `.env`.
# Cloudflare loads `.env` into the local Worker, so do NOT add deployment-only
# credentials such as CLOUDFLARE_API_TOKEN, marketplace tokens, or signing keys.
# Production runtime secrets will be uploaded individually with Wrangler.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

APP_ENV=development
PUBLIC_APP_URL=http://localhost:8787
LOG_LEVEL=info

# Generate two independent, cryptographically random 32-byte Base64 values.
APP_SESSION_SECRET=
DATA_ENCRYPTION_KEY=

# The device-scoped environment fingerprint HMAC key is generated by the
# Companion and stored only in the operating-system credential store. It is
# intentionally not a cloud/application environment variable.

# -----------------------------------------------------------------------------
# Neon Postgres
# -----------------------------------------------------------------------------

# Pooled connection string for the running Worker. The hostname normally
# contains "-pooler".
DATABASE_URL=

# Direct, non-pooled connection string used only by local/CI schema migrations.
# Do not upload this value as a production Worker runtime secret.
DATABASE_DIRECT_URL=

# -----------------------------------------------------------------------------
# Daytona
# -----------------------------------------------------------------------------

DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
# Allowed managed targets: us or eu.
DAYTONA_TARGET=us

# -----------------------------------------------------------------------------
# Fireworks AI
# -----------------------------------------------------------------------------

FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
# Current coding-focused serverless candidate. The Braintrust promotion gate
# must evaluate it before production use, and this remains configurable because
# Fireworks serverless availability changes over time.
FIREWORKS_MODEL_ID=accounts/fireworks/models/kimi-k2p7-code

# -----------------------------------------------------------------------------
# Braintrust
# -----------------------------------------------------------------------------

# Prefer a project-scoped Braintrust service token (bt-st-...) for the backend.
BRAINTRUST_API_KEY=
# Use https://api-eu.braintrust.dev for an EU data plane.
BRAINTRUST_API_URL=https://api.braintrust.dev
BRAINTRUST_PROJECT_NAME=verified-environment-reconciliation
BRAINTRUST_ENABLED=true

# -----------------------------------------------------------------------------
# GitHub App
# -----------------------------------------------------------------------------

# Create this after a public workers.dev development URL is available. Set
# PUBLIC_APP_URL to that URL when testing GitHub webhooks and OAuth remotely.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_WEBHOOK_SECRET=

# Base64 of the complete PEM file downloaded from the GitHub App settings.
# Base64 is only an encoding; this value remains a critical secret.
GITHUB_APP_PRIVATE_KEY_BASE64=

# -----------------------------------------------------------------------------
# Cloudflare R2 direct object transfer
# -----------------------------------------------------------------------------

# Required when the Companion and Daytona use short-lived direct R2 upload or
# download URLs for large encrypted objects. Create a bucket-scoped R2 S3 API
# token with Object Read & Write only; do not use an account-wide Admin token.
R2_S3_ENDPOINT=
R2_S3_ACCESS_KEY_ID=
R2_S3_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=verified-environment-reconciliation

# -----------------------------------------------------------------------------
# Cloudflare tooling (non-secret)
# -----------------------------------------------------------------------------

# Find this in the Cloudflare dashboard. Local authentication should use
# `npx wrangler login`; never place CLOUDFLARE_API_TOKEN in this file.
CLOUDFLARE_ACCOUNT_ID=
